class VoiceOrb(Gtk.DrawingArea):
    """A deliberately simple, state-first circular status indicator."""

    COLORS = {
        "ready": (0.18, 0.84, 0.77),
        "listening": (0.24, 0.94, 0.86),
        "transcribing": (1.0, 0.67, 0.22),
        "working": (0.34, 0.9, 0.57),
        "error": (1.0, 0.39, 0.39),
        "speaking": (0.39, 0.66, 1.0),
    }

    def __init__(self) -> None:
        super().__init__()
        self.set_content_width(150)
        self.set_content_height(150)
        self.set_hexpand(True)
        self.state = "ready"
        self.phase = 0.0
        self.animation_source = 0
        self.set_draw_func(self.draw_orb)

    def set_state(self, state: str) -> None:
        state = state if state in self.COLORS else "ready"
        if self.state != state:
            self.state = state
            self.queue_draw()
        animated = state in {"listening", "transcribing", "speaking"}
        if animated and not self.animation_source and Gtk.Settings.get_default().get_property("gtk-enable-animations"):
            self.animation_source = GLib.timeout_add(90, self.tick)
        elif not animated and self.animation_source:
            GLib.source_remove(self.animation_source)
            self.animation_source = 0

    def tick(self) -> bool:
        self.phase = (self.phase + 0.20) % (math.pi * 2)
        self.queue_draw()
        return True

    def draw_orb(self, _area: Gtk.DrawingArea, cr, width: int, height: int) -> None:
        scale = min(width, height) / 300
        cr.translate((width - 300 * scale) / 2, (height - 300 * scale) / 2)
        cr.scale(scale, scale)
        width = height = 300
        size = min(width, height)
        cx, cy = width / 2, height / 2
        radius = size * 0.445
        red, green, blue = self.COLORS[self.state]
        import cairo
        surface = cairo.RadialGradient(cx, cy - 30, 10, cx, cy, radius + 10)
        surface.add_color_stop_rgb(0, .035, .115, .125)
        surface.add_color_stop_rgb(1, .035, .055, .065)
        cr.set_source(surface)
        cr.arc(cx, cy, radius + 10, 0, math.pi * 2)
        cr.fill()
        cr.set_source_rgba(.20, .25, .28, .9)
        cr.set_line_width(8)
        cr.arc(cx, cy, radius, 0, math.pi * 2)
        cr.stroke()
        inner = radius - 29
        fill = cairo.RadialGradient(cx, cy - 15, 10, cx, cy, inner)
        fill.add_color_stop_rgba(0, .025, .24, .25, 1)
        fill.add_color_stop_rgba(1, .025, .13, .14, 1)
        cr.set_source(fill)
        cr.arc(cx, cy, inner, 0, math.pi * 2)
        cr.fill()
        cr.set_source_rgba(.15, .68, .66, .55)
        cr.set_line_width(2)
        cr.arc(cx, cy, inner, 0, math.pi * 2)
        cr.stroke()
        start = -math.pi / 2
        span = math.pi * 2 if self.state in {"listening", "working"} else math.pi * .55
        if self.state == "transcribing":
            start += self.phase
        cr.set_line_cap(1)
        if self.state != "ready":
            for line, opacity in ((18, .035), (12, .09), (8, 1)):
                cr.set_line_width(line)
                cr.set_source_rgba(red, green, blue, opacity)
                cr.arc(cx, cy, radius, start, start + span)
                cr.stroke()
        levels = (10, 26, 40, 67, 40, 26, 10)
        for index, level in enumerate(levels):
            if self.state in {"listening", "speaking"}:
                level *= .7 + .3 * math.sin(self.phase + index * .8)
            x, y = cx + (index - 3) * 18, cy - 13
            for line, opacity in ((13, .05), (9, .10), (7, .95)):
                cr.set_source_rgba(.20, .94, .87, opacity if self.state != "ready" else opacity * .6)
                cr.set_line_width(line)
                cr.move_to(x, y - level / 2)
                cr.line_to(x, y + level / 2)
                cr.stroke()


