    def set_state(self, state: str, message: str | None = None) -> None:
        if self.closed:
            return
        title, hint = self.STATUS.get(state, self.STATUS["ready"])
        self.status_label.set_text(title)
        self.hint_label.set_text(hint)
        self.orb.set_state(state)
        self.orb.set_tooltip_text(hint)
        if message:
            self.show_result(message, "error" if state == "error" else "info")

    def start_voice_service(self) -> None:
        """Run Voxtype as Yoda's child, not through a detached user service.

        A desktop-file launch does not reliably inherit the environment needed
        by `systemctl --user`.  A child process has the same audio, display,
        and keyboard permissions as this window and stops with it.
        """
        try:
            input_gid = grp.getgrnam("input").gr_gid
        except KeyError:
            input_gid = -1
        if input_gid not in os.getgroups():
            self.set_state(
                "error",
                "Táto relácia ešte nemá prístup ku klávesnici. Odhlás sa a znovu prihlás.",
            )
            return
        try:
            STATE_FILE.parent.mkdir(parents=True, exist_ok=True)
            TRANSCRIPT_FILE.unlink(missing_ok=True)
            config = (CONFIG_HOME / "voxtype/config.toml").read_text(encoding="utf-8")
            config = re.sub(r'(?ms)(^\[output\]\n)(.*?)(?=^\[|\Z)',
                            lambda match: match[1] + re.sub(r'^mode\s*=.*$', 'mode = "file"', match[2], flags=re.M), config)
            config = re.sub(r'(?ms)(^\[whisper\]\n)(.*?)(?=^\[|\Z)',
                            lambda match: match[1] + re.sub(r'^(context_window_optimization|threads)\s*=.*\n?', '', match[2], flags=re.M)
                            + '\ncontext_window_optimization = true\nthreads = 4\n', config)
            config = re.sub(r'^on_transcription\s*=.*$', 'on_transcription = false', config, flags=re.M)
            YODA_CONFIG.write_text(config, encoding="utf-8")
            log = VOXTYPE_LOG.open("w", encoding="utf-8")
            self.voxtype_process = subprocess.Popen(
                [VOXTYPE, "--config", str(YODA_CONFIG), "--engine", "whisper",
                 "--whisper-mode", "local", "--file-path", str(TRANSCRIPT_FILE),
                 "--file-mode", "overwrite", "daemon"],
                stdin=subprocess.DEVNULL,
                stdout=log,
                stderr=subprocess.STDOUT,
                start_new_session=True,
            )
            log.close()
        except OSError:
            self.set_state("error", "Voxtype sa nepodarilo spustiť. Skús Yodu znovu otvoriť.")
            return
        GLib.timeout_add(900, self.confirm_voice_start)

    def confirm_voice_start(self) -> bool:
        if self.voxtype_process and self.voxtype_process.poll() is None:
            self.voice_available = True
            self.set_state("ready", "Podrž pravý Ctrl a hovor")
        else:
            self.voice_available = False
            self.set_state("error", "Hlasový vstup sa nespustil. Zatvor a znovu otvor Yodu.")
        return False

    def stop_voice_service(self) -> None:
        process = self.voxtype_process
        self.voxtype_process = None
        self.voice_available = False
        if process and process.poll() is None:
            process.terminate()
            try:
                process.wait(timeout=3)
            except subprocess.TimeoutExpired:
                process.kill()
                process.wait()

    def read_voxtype_state(self) -> str:
        try:
            return STATE_FILE.read_text(encoding="utf-8").strip()
        except (OSError, UnicodeError):
            return "unavailable"

    def poll_voxtype(self) -> bool:
        if self.closed:
            return False
        if not self.voice_available:
            return True
        if self.voxtype_process and self.voxtype_process.poll() is not None:
            self.voice_available = False
            self.set_state("error", "Voxtype sa zastavil. Podrobnosti sú v yoda-voxtype.log.")
            return True
        state = self.read_voxtype_state()
        previous = self.previous_voxtype_state
        if state not in {"idle", "recording", "transcribing"}:
            self.set_state("error", "Stav hlasového vstupu nie je dostupný. Zatvor a znovu otvor Yodu.")
            self.previous_voxtype_state = state
            return True
        if state == "recording" and previous != "recording":
            self.stop_speech()
            try:
                TRANSCRIPT_FILE.unlink(missing_ok=True)
            except OSError:
                self.set_state("error", "Prepis sa nedá vyčistiť. Zatvor a znovu otvor Yodu.")
                return True
            self.entry.set_text("")
            self.last_executed_text = ""
        if state == "idle" and TRANSCRIPT_FILE.exists():
            try:
                transcript = TRANSCRIPT_FILE.read_text(encoding="utf-8").strip()
                TRANSCRIPT_FILE.unlink()
            except FileNotFoundError:
                return True
            except (OSError, UnicodeError):
                self.set_state("error", "Prepis sa nedá prečítať. Zatvor a znovu otvor Yodu.")
                return True
            if transcript:
                self.entry.set_text(transcript)
                self.entry.set_position(-1)
                self.stop_speech()
                self.try_execute_transcript()
            self.previous_voxtype_state = state
            return True
        if state == "recording" and previous != state:
            self.set_state("listening", "Počúvam. Pusti pravý Ctrl, keď skončíš.")
        elif state == "transcribing" and previous != state:
            self.set_state("transcribing", "Prepisujem lokálne, bez odosielania zvuku.")
        elif state == "idle" and previous == "transcribing":
            self.set_state("ready", "Nerozpoznal som text. Podrž pravý Ctrl a skús znova.")
        elif state == "idle" and previous != "idle" and not self.command_in_progress and self.orb.state != "speaking":
            self.set_state("ready")
        self.previous_voxtype_state = state
        return True

    def handle_entry(self, _entry: Gtk.Entry) -> None:
        self.last_executed_text = ""
        self.try_execute_transcript()

    def try_execute_transcript(self) -> bool:
        if self.closed:
            return False
        if self.command_in_progress:
            self.set_state("working")
            self.show_result("Dokončujem príkaz. Potom stlač Enter pre nový text.")
            return False
        self.stop_speech()
        transcript = self.entry.get_text().strip()
        phrase = normalize(transcript)
        if not phrase:
            return False
        if phrase in {"zrus", "storno"}:
            self.entry.set_text("")
            self.set_state("ready", "Príkaz zrušený.")
            return False
        # Only a fixed polite suffix is allowed; never guess similar commands.
        if phrase.endswith(" prosim"):
            phrase = phrase[:-7].rstrip()
        if transcript == self.last_executed_text:
            return False
        command = COMMANDS.get(phrase)
        if not command:
            self.set_state("error")
            self.show_result("Príkaz nepoznám. Uprav text a stlač Enter.", "error")
            return False
        self.last_executed_text = transcript
        self.command_in_progress = True
        self.entry.set_sensitive(False)
        self.set_state("working", command.label)
        def execute() -> None:
            started = time.monotonic()
            success = False
            try:
                completed = subprocess.run(command.argv, stdin=subprocess.DEVNULL,
                                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                                           start_new_session=True, timeout=15, check=False)
                success = completed.returncode == 0
            except (OSError, subprocess.SubprocessError):
                pass
            delay = max(1, int((.6 - (time.monotonic() - started)) * 1000))
            GLib.timeout_add(delay, self.finish_command, success, command.spoken)

        threading.Thread(target=execute, daemon=True).start()
        return False

    def finish_command(self, success: bool, spoken: str) -> bool:
        if self.closed:
            return False
        pending_text = bool(self.entry.get_text().strip()) and self.entry.get_text().strip() != self.last_executed_text
        message = spoken if success else "Príkaz sa nepodarilo vykonať."
        if pending_text:
            message = "Hotovo. Nový text spustíš Enterom." if success else "Príkaz zlyhal. Nový text spustíš Enterom."
        self.show_result(message, "success" if success else "error")
        self.entry.set_sensitive(True)
        self.command_in_progress = False
        # Never speak into a new recording or overwrite its visual state.
        if self.orb.state in {"listening", "transcribing"}:
            return False
        if success and not pending_text and self.output_switch.get_active():
            self.speak(spoken)
        else:
            self.set_state("ready" if success else "error")

        return False

    def read_output_state(self) -> bool:
        try:
            return VOICE_STATE.read_text(encoding="utf-8").strip() == "on"
        except OSError:
            return False

    def toggle_output(self, _switch: Gtk.Switch, active: bool) -> bool:
        try:
            VOICE_STATE.parent.mkdir(parents=True, exist_ok=True)
            VOICE_STATE.write_text("on\n" if active else "off\n", encoding="utf-8")
            if not active:
                self.stop_speech()
                if self.orb.state == "speaking":
                    self.set_state("ready")
            self.show_result("Hlas Lili je zapnutý." if active else "Hlas Lili je vypnutý.")
        except OSError:
            self.show_result("Nastavenie hlasového výstupu sa nepodarilo uložiť.", "error")
            return True
        return False

    def stop_speech(self) -> None:
        with self.speech_lock:
            self.speech_cancel.set()
            process = self.speech_process
            if process and process.poll() is None:
                try:
                    process.terminate()
                except ProcessLookupError:
                    pass
        self.speech_in_progress = False

    def speak(self, text: str) -> None:
        self.stop_speech()
        if self.closed:
            return
        if not (PIPER.is_file() and LILI.is_file() and Path(MPV).is_file()):
            self.set_state("ready")
            self.show_result("Príkaz vykonaný; lokálny hlas Lili nie je dostupný.")
            return
        cancelled = threading.Event()
        self.speech_cancel = cancelled
        self.speech_in_progress = True
        self.set_state("speaking")

        def run_voice(argv, timeout: int, input_text: str | None = None) -> None:
            with self.speech_lock:
                if cancelled.is_set():
                    return
                process = subprocess.Popen(argv, stdin=subprocess.PIPE if input_text else subprocess.DEVNULL,
                                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, text=True)
                self.speech_process = process
            try:
                process.communicate(input_text, timeout=timeout)
                if process.returncode:
                    raise subprocess.CalledProcessError(process.returncode, argv)
            except subprocess.TimeoutExpired:
                process.kill()
                process.communicate()
                raise
            finally:
                with self.speech_lock:
                    if self.speech_process is process:
                        self.speech_process = None

        def worker() -> None:
            path = ""
            failed = False
            try:
                with tempfile.NamedTemporaryFile(prefix="yoda-", suffix=".wav", delete=False) as output:
                    path = output.name
                run_voice([str(PIPER), "--model", str(LILI), "--output_file", path], 25, text + "\n")
                run_voice([MPV, "--no-video", "--really-quiet", path], 30)
            except (OSError, subprocess.SubprocessError):
                failed = not cancelled.is_set()
            finally:
                if path:
                    try:
                        Path(path).unlink(missing_ok=True)
                    except OSError:
                        pass
                GLib.idle_add(self.finish_speech, cancelled, failed)

        threading.Thread(target=worker, daemon=True).start()

    def finish_speech(self, cancelled: threading.Event, failed: bool = False) -> bool:
        if cancelled is not self.speech_cancel or cancelled.is_set() or self.closed:
            return False
        self.speech_in_progress = False
        if self.orb.state == "speaking":
            self.set_state("ready")
        if failed:
            self.show_result("Príkaz vykonaný; hlas Lili sa nepodarilo prehrať.")
        return False

    def on_close(self, *_args) -> bool:
        self.closed = True
        self.stop_speech()
        if self.orb.animation_source:
            GLib.source_remove(self.orb.animation_source)
            self.orb.animation_source = 0
        self.stop_voice_service()
        self.get_application().quit()
        return False


class YodaApplication(Gtk.Application):
    def __init__(self) -> None:
        super().__init__(application_id=APP_ID)

    def do_activate(self) -> None:
        window = self.props.active_window
        if not window:
            window = YodaWindow(self)
        window.present()


def self_test() -> int:
    required = {"otvor terminal", "otvor subory", "otvor codex", "otvor opencode", "zamkni pocitac"}
    missing = required.difference(COMMANDS)
    if missing:
        print(f"missing command phrases: {sorted(missing)}")
        return 1
    if normalize("OtvOr  terminál!") != "otvor terminal":
        print("normalization check failed")
        return 1
    print(f"ok: {len(COMMANDS)} exact local phrases")
    return 0


if __name__ == "__main__":
    if "--self-test" in sys.argv:
        raise SystemExit(self_test())
    raise SystemExit(YodaApplication().run(sys.argv))
