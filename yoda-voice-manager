def normalize(text: str) -> str:
    decomposed = unicodedata.normalize("NFKD", text.casefold())
    plain = "".join(char for char in decomposed if not unicodedata.combining(char))
    return " ".join("".join(char if char.isalnum() else " " for char in plain).split())


@dataclass(frozen=True)
class Command:
    label: str
    spoken: str
    argv: tuple[str, ...]


COMMANDS: dict[str, Command] = {}


def register(phrases: tuple[str, ...], label: str, spoken: str, *argv: str) -> None:
    command = Command(label, spoken, tuple(argv))
    for phrase in phrases:
        COMMANDS[normalize(phrase)] = command


